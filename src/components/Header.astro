---
import { cafe } from "../data/cafe";

const links = [
  { href: "#om", label: "Om oss" },
  { href: "#meny", label: "Meny" },
  { href: "#bestallning", label: "Beställ" },
  { href: "#hitta-hit", label: "Hitta hit" },
];
---

<header class="site-header">
  <div class="site-header__inner wrap">
    <a class="wordmark" href="#hero">
      <!-- TODO: byt ut mot kundens logotyp i vektorformat (SVG) när den finns. -->
      {cafe.name}
    </a>
    <nav class="site-nav" aria-label="Huvudmeny">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--color-line);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.1rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: var(--weight-display, 600);
    font-size: 1.4rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .site-nav a {
    text-decoration: none;
    font-size: 0.98rem;
    color: var(--color-text-muted);
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }
</style>
