---
// Beställningssektionen — mailas till caféet. Avsiktligt begränsat scope
// (se CLAUDE.md): inget kassaflöde, ingen betalning, inga kundkonton.
//
// Två delflöden i samma sektion:
// - <OrderShop>: vardagssortimentet (fast pris) som en lista man trycker
//   plus/minus på — den primära, låg-friktions-vägen för lokala kunder som
//   bara vill ha bröd eller bullar.
// - <SpecialRequest>: tårta/moussetårta/annat utan fast pris — en visuellt
//   lugnare fritext-förfrågan, sekundär till shopen.
//
// Varje delflöde är sitt eget statiska Netlify-formulär (se respektive
// komponent för fältdetaljer) — ingen egen serverkod krävs.
import OrderShop from "./OrderShop.astro";
import SpecialRequest from "./SpecialRequest.astro";

interface Props {
  theme: "v1" | "v2" | "v3";
}

const { theme } = Astro.props;
---

<section class="order section" id="bestallning">
  <div class="wrap order__wrap">
    <OrderShop theme={theme} />
    <SpecialRequest theme={theme} />
  </div>
</section>

<style>
  .order__wrap {
    display: grid;
    gap: clamp(3rem, 8vw, 5rem);
  }
</style>
