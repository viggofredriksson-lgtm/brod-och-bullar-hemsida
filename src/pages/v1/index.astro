---
import "../../styles/tokens-v1.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Menu from "../../components/Menu.astro";
import OrderForm from "../../components/OrderForm.astro";
import FindUs from "../../components/FindUs.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  theme="v1"
  title="Mollösunds Bröd & Bullar — bröd och bakverk i Mollösund"
  description="Surdegsbröd, bullar och bakverk från Herr Bröd, sålt i hjärtat av Mollösund. Beställ tårta eller catering i god tid, eller kom förbi och se vad som finns kvar."
>
  <Header />
  <main id="main">
    <Hero variant="bleed" />
    <About />
    <Menu />
    <OrderForm theme="v1" />
    <FindUs />
  </main>
  <Footer />
</BaseLayout>
