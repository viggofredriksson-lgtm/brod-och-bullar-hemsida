---
import "../../styles/tokens-v1.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout theme="v1" title="Tack för din beställning — Bröd och bullar" description="Vi har tagit emot din beställning och återkommer inom kort.">
  <Header />
  <main id="main" class="section wrap">
    <p class="eyebrow">Mottaget</p>
    <h1>Tack för din beställning!</h1>
    <p class="tack__text">
      Vi hör av oss inom ett par vardagar för att bekräfta datum och pris. Har du bråttom är du
      alltid välkommen att ringa oss också.
    </p>
    <a class="button" href="/v1#hero">Tillbaka till startsidan</a>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tack__text {
    margin-block: 1rem 2rem;
    max-width: 50ch;
  }

  h1 {
    margin-block: 0.3em 0.5em;
  }
</style>
